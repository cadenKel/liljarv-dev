{
  "version": 2,
  "env": {
    "STRIPE_SECRET_KEY": "@stripe_secret_key"
  },
  "builds": [
    { "src": "www/api/*.js", "use": "@vercel/node" },
    { "src": "www/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/products", "dest": "/www/api/products.js" },
    { "src": "/api/order", "dest": "/www/api/order.js" },
    { "src": "/api/review", "dest": "/www/api/review.js" },
    { "src": "/products.json", "dest": "/www/products.json" },
    { "src": "/llms.txt", "dest": "/www/llms.txt" },
    { "src": "/(.*)", "dest": "/www/$1" }
  ]
}
